# TAG AI Platform - Backend Environment Variables

# Application
APP_NAME="TAG AI Platform"
VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/tag_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=300

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=
OPENAI_MODEL=gpt-4-turbo-preview
MAX_TOKENS_PER_REQUEST=4000
AI_GENERATION_TIMEOUT=300

# Perplexity
PERPLEXITY_API_KEY=

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ElevenLabs (Audio)
ELEVENLABS_API_KEY=

# Gaming APIs
STEAM_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# WordPress Publishing
WORDPRESS_API_URL=https://twoaveragegamers.com/wp-json/wp/v2
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Social Media
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=52428800
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Performance
MAX_CONCURRENT_GENERATIONS=5
CONTENT_QUALITY_THRESHOLD=0.85

# Features
ENABLE_AB_TESTING=false
ENABLE_VOICE_COMMANDS=false
ENABLE_OFFLINE_MODE=false

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
